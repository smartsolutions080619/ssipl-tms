<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8"/>
  <style>
    body{font-family:-apple-system,sans-serif;background:#f0f4f4;margin:0;padding:32px 16px}
    .card{background:white;border-radius:16px;max-width:480px;margin:0 auto;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08)}
    .header{background:linear-gradient(135deg,#1a3a3f,#228b98);padding:32px;text-align:center}
    .logo{color:white;font-size:22px;font-weight:800}
    .sub{color:rgba(255,255,255,0.5);font-size:12px;display:block;margin-top:4px}
    .body{padding:32px}
    h2{color:#1a2e2f;font-size:20px;font-weight:700;margin:0 0 12px}
    p{color:#3d6b70;font-size:14px;line-height:1.6;margin:0 0 16px}
    .btn{display:block;background:linear-gradient(135deg,#228b98,#1a7a85);color:white;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:700;font-size:14px;text-align:center;margin:24px 0}
    .warn{background:rgba(248,113,113,0.08);border:1px solid rgba(248,113,113,0.2);border-radius:8px;padding:12px 16px;font-size:12px;color:#dc2626}
    .footer{padding:20px 32px;background:#f8fafa;border-top:1px solid #e8f1f2;color:#7aaa8a;font-size:12px;text-align:center}
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <div class="logo">SSIPL TMS<span class="sub">Task Management System</span></div>
    </div>
    <div class="body">
      <h2>Reset your password</h2>
      <p>Hi {{name}},</p>
      <p>We received a request to reset your password. Click below — link expires in <strong>1 hour</strong>.</p>
      <a href="{{resetUrl}}" class="btn">Reset Password</a>
      <div class="warn">If you didn't request this, ignore this email. Your password won't change.</div>
    </div>
    <div class="footer">© 2026 SSIPL TMS · The Smart Solutions</div>
  </div>
</body>
</html>